FROM node:22-alpine AS frontend
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.js ./
COPY src ./src
ENV VITE_API_BASE_URL=""
RUN npm run build

FROM caddy:2 AS proxy
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 APP_ENV=production
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 libgomp1 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY backend/requirements-runtime.txt ./
RUN pip install --no-cache-dir -r requirements-runtime.txt && groupadd -g 10001 screener && useradd -u 10001 -g screener -s /usr/sbin/nologin screener
COPY --from=proxy /usr/bin/caddy /usr/bin/caddy
COPY --from=frontend /build/dist /srv
COPY backend/*.py ./
COPY deploy/logging.json /app/logging.json
COPY deploy/Caddyfile.render /app/Caddyfile
USER 10001:10001
EXPOSE 10000
CMD ["python", "render_start.py"]
