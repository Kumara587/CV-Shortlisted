{
    # Disable gateway request/runtime logs; application emits sanitized events only.
    log {
        output discard
    }
}
{$APP_DOMAIN} {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; img-src 'self' data: https://lh3.googleusercontent.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        Cross-Origin-Opener-Policy "same-origin-allow-popups"
        -Server
    }
    handle /api/* {
        request_body {
            max_size 10MB
        }
        reverse_proxy api:8000
    }
    handle /health {
        reverse_proxy api:8000
    }
    handle {
        root * /srv
        try_files {path} /index.html
        header Cache-Control "no-store"
        file_server
    }
}
